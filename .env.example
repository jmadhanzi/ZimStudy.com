# Copy this file to .env and update with your actual values

# Database
DATABASE_URL="postgresql://zimstudy:zimstudy_password_change_in_production@localhost:5432/zimstudy?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:3000"

# Twilio (for WhatsApp integration)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Optional: WhatsApp Business API
WHATSAPP_BUSINESS_API_URL="https://your-whatsapp-business-api.com"
WHATSAPP_BUSINESS_API_TOKEN="your-api-token"
WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
